# Copy to .env (next to this file) for local runs, or set these as variables on your host.
# Anything left blank gets a random value printed at startup. Fine for a test, but set them for real
# so links and tokens don't change on every restart.

ADMIN_PASSWORD=
OVERLAY_KEY=
ZOE_TOKEN=
CLARA_TOKEN=

# Ports. PORT is HTTP (overlay, admin, setup, websocket). TCP_PORT is raw TCP from the mGBA scripts.
PORT=8080
TCP_PORT=9000

# What Clara's script is told to connect to. Must be reachable from HER network:
#   home PC + port forward:  your public IP or DDNS name, and the forwarded port
#   Railway TCP proxy:       something.proxy.rlwy.net and its port
PUBLIC_TCP_HOST=localhost
PUBLIC_TCP_PORT=9000
# Public base URL for links shown on the admin page (no trailing slash), e.g. https://pals.example.com
PUBLIC_URL=

# Where the dex lives. Back this file up!
# DB_PATH=./data/pinball-pals.sqlite

# Should progress already in each save count toward the shared dex? (GDD open question)
COUNT_EXISTING_PROGRESS=true

# Optional: player colours
# ZOE_COLOR=#ff8fb1
# CLARA_COLOR=#8fc7ff

# Optional: Twitch chat bot (use a dedicated bot account). Token looks like oauth:abc123...
TWITCH_CHANNEL=
TWITCH_BOT_NAME=
TWITCH_BOT_TOKEN=
